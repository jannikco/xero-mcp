{
  "name": "xero-mcp",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Use Xero with AI agents through one PipMCP API key, actual hosted schemas and governed execution.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs"
    }
  },
  "bin": {
    "xero-mcp": "server.mjs"
  },
  "scripts": {
    "start": "node example.mjs",
    "doctor": "node doctor.mjs",
    "server": "node server.mjs",
    "test": "node --test tests/*.test.mjs && node --test demo/demo.test.mjs",
    "demo": "node demo/run.mjs",
    "preflight": "node demo/run.mjs --preflight",
    "verify:read": "node demo/run.mjs --live-read"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "files": [
    "lib",
    "server.mjs",
    "doctor.mjs",
    "example.mjs",
    "README.md",
    "LICENSE",
    "capabilities.json",
    "docs",
    "demo"
  ]
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Xero selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.xero.com/api.xro/2.0"
    }
  ],
  "paths": {
    "/Contacts": {
      "get": {
        "operationId": "xero_list_contacts",
        "summary": "xero list contacts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "put": {
        "operationId": "xero_create_contacts",
        "summary": "xero create contacts",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Contacts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "Name": {
                          "type": "string"
                        },
                        "EmailAddress": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "Name"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "Contacts"
                ]
              }
            }
          }
        }
      }
    },
    "/Contacts/{ContactID}": {
      "get": {
        "operationId": "xero_get_contact",
        "summary": "xero get contact",
        "parameters": [
          {
            "name": "ContactID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "header_xero_tenant_id": {
        "type": "apiKey",
        "in": "header",
        "name": "xero-tenant-id"
      }
    }
  },
  "security": [
    {
      "providerAuth": [],
      "header_xero_tenant_id": []
    }
  ]
}
